   "source": [
    "# ---------- Target distribution on S^1 ----------\n",
    "mode_centers = np.array([-2.4, 0.15, 2.2])\n",
    "mode_weights = np.array([0.35, 0.35, 0.30])\n",
    "mode_kappa = np.array([32.0, 26.0, 30.0])\n",
    "\n",
    "def sample_circle_modes(n):\n",
    "    c = np.random.choice(len(mode_centers), size=n, p=mode_weights)\n",
    "    th = np.array([np.random.vonmises(mode_centers[i], mode_kappa[i]) for i in c])\n",
    "    return wrap_angle(th)\n",
    "\n",
    "theta0 = sample_circle_modes(6000)\n",
    "x0_circle = theta_to_xy(theta0)\n",
    "\n",
    "# ---------- Euclidean ambient score approximation ----------\n",
    "def euclidean_kde_score(x, particles, bandwidth=0.32):\n",
    "    diff = x[:, None, :] - particles[None, :, :]             # (N,M,2)\n",
    "    sq = np.sum(diff**2, axis=-1)                            # (N,M)\n",
    "    w = np.exp(-0.5 * sq / (bandwidth**2))                  # (N,M)\n",
    "    den = np.sum(w, axis=1, keepdims=True) + 1e-12\n",
    "    num = -np.sum(w[:, :, None] * diff, axis=1) / (bandwidth**2)\n",
    "    return num / den\n",
    "\n",
    "def make_ambient_score_table(x0, t_grid, particles_per_t=1400):\n",
    "    table = {}\n",
    "    n0 = len(x0)\n",
    "    for t in t_grid:\n",
    "        idx = np.random.choice(n0, size=particles_per_t, replace=True)\n",
    "        x_t = alpha_t(t) * x0[idx] + sigma_t(t) * np.random.randn(particles_per_t, 2)\n",
    "        table[float(t)] = x_t\n",
    "    return table\n",
    "\n",
    "def ambient_score_fn(x, t, table, t_grid):\n",
    "    t_near = float(t_grid[np.argmin(np.abs(t_grid - t))])\n",
    "    return euclidean_kde_score(x, table[t_near])\n",
    "\n",
    "def reverse_ambient_from_prior(table, t_grid, n_samples=3000, n_steps=320):\n",
    "    x = np.random.randn(n_samples, 2)\n",
    "    ts = np.linspace(1.0, 1e-3, n_steps)\n",
    "    traj_idx = np.random.choice(n_samples, size=24, replace=False)\n",
    "    traj = [x[traj_idx].copy()]\n",
    "\n",
    "    for i in range(n_steps - 1):\n",
    "        t = ts[i]\n",
    "        dt = ts[i] - ts[i+1]\n",
    "        b = beta_t(t)\n",
    "        s = ambient_score_fn(x, t, table, t_grid)\n",
    "        drift = 0.5 * b * x + b * s\n",
    "        x = x + drift * dt + np.sqrt(b * dt) * np.random.randn(*x.shape)\n",
    "        if i % 10 == 0:\n",
    "            traj.append(x[traj_idx].copy())\n",
    "    return x, np.array(traj)\n",
    "\n",
    "# ---------- Riemannian (S^1) score approximation ----------\n",
    "BETA_CIRCLE = 8.0\n",
    "\n",
    "def make_circle_score_table(theta0, t_grid, particles_per_t=1800):\n",
    "    table = {}\n",
    "    n0 = len(theta0)\n",
    "    for t in t_grid:\n",
    "        idx = np.random.choice(n0, size=particles_per_t, replace=True)\n",
    "        th_t = wrap_angle(theta0[idx] + np.sqrt(BETA_CIRCLE * t) * np.random.randn(particles_per_t))\n",
    "        table[float(t)] = th_t\n",
    "    return table\n",
    "\n",
    "def circle_score_fn(theta, t, table, t_grid, kappa=20.0):\n",
    "    t_near = float(t_grid[np.argmin(np.abs(t_grid - t))])\n",
    "    particles = table[t_near]                               # (M,)\n",
    "    delta = particles[None, :] - theta[:, None]            # (N,M), on circle\n",
    "    w = np.exp(kappa * np.cos(delta))\n",
    "    den = np.mean(w, axis=1) + 1e-12\n",
    "    num = kappa * np.mean(w * np.sin(delta), axis=1)\n",
    "    return num / den                                        # intrinsic grad d/dtheta log p_t\n",
    "\n",
    "def reverse_circle_from_uniform(table, t_grid, n_samples=3000, n_steps=320):\n",
    "    theta = np.random.uniform(-np.pi, np.pi, size=n_samples)\n",
    "    ts = np.linspace(1.0, 1e-3, n_steps)\n",
    "    traj_idx = np.random.choice(n_samples, size=24, replace=False)\n",
    "    traj = [theta[traj_idx].copy()]\n",
    "\n",
    "    for i in range(n_steps - 1):\n",
    "        t = ts[i]\n",
    "        dt = ts[i] - ts[i+1]\n",
    "        s = circle_score_fn(theta, t, table, t_grid)\n",
    "        theta = wrap_angle(theta + BETA_CIRCLE * s * dt + np.sqrt(BETA_CIRCLE * dt) * np.random.randn(n_samples))\n",
    "        if i % 10 == 0:\n",
    "            traj.append(theta[traj_idx].copy())\n",
    "    return theta, np.array(traj)\n",
    "\n",
    "# Build score tables and sample\n",
    "t_grid = np.linspace(1e-3, 1.0, 55)\n",
    "ambient_table = make_ambient_score_table(x0_circle, t_grid=t_grid, particles_per_t=1400)\n",
    "circle_table = make_circle_score_table(theta0, t_grid=t_grid, particles_per_t=1800)\n",
    "\n",
    "x_euclid, traj_euclid = reverse_ambient_from_prior(ambient_table, t_grid, n_samples=3200, n_steps=320)\n",
    "theta_riem, traj_riem = reverse_circle_from_uniform(circle_table, t_grid, n_samples=3200, n_steps=320)\n",
    "x_riem = theta_to_xy(theta_riem)\n",
    "\n",
    "# Metrics\n",
    "radius_euclid = np.linalg.norm(x_euclid, axis=1)\n",
    "radius_riem = np.linalg.norm(x_riem, axis=1)\n",
    "radius_mae_euclid = float(np.mean(np.abs(radius_euclid - 1.0)))\n",
    "radius_mae_riem = float(np.mean(np.abs(radius_riem - 1.0)))\n",
    "\n",
    "bins = 72\n",
    "target_hist, _ = np.histogram(theta0, bins=bins, range=(-np.pi, np.pi), density=True)\n",
    "euclid_hist, _ = np.histogram(xy_to_theta(x_euclid), bins=bins, range=(-np.pi, np.pi), density=True)\n",
    "riem_hist, _ = np.histogram(theta_riem, bins=bins, range=(-np.pi, np.pi), density=True)\n",
    "\n",
    "kl_euclid = kl_div(target_hist, euclid_hist)\n",
    "kl_riem = kl_div(target_hist, riem_hist)\n",
    "\n",
    "print(f'Radius MAE to unit circle | Euclidean ambient: {radius_mae_euclid:.4f}')\n",
    "print(f'Radius MAE to unit circle | Riemannian S^1   : {radius_mae_riem:.4f}')\n",
    "print(f'Angular KL(target || sample) | Euclidean ambient: {kl_euclid:.4f}')\n",
    "print(f'Angular KL(target || sample) | Riemannian S^1   : {kl_riem:.4f}')\n",
    "\n",
    "# Visualization\n",
    "fig, ax = plt.subplots(2, 3, figsize=(15, 9))\n",
    "\n",
    "# Target manifold data\n",
    "ax[0,0].scatter(x0_circle[:,0], x0_circle[:,1], s=4, alpha=0.25)\n",
    "ax[0,0].set_title('Target data on S^1 (3 modes)')\n",
    "\n",
    "# Euclidean ambient reverse\n",
    "ax[0,1].scatter(x_euclid[:,0], x_euclid[:,1], s=4, alpha=0.25, color='tab:orange')\n",
    "for k in range(traj_euclid.shape[1]):\n",
    "    ax[0,1].plot(traj_euclid[:,k,0], traj_euclid[:,k,1], color='black', lw=0.8, alpha=0.45)\n",
    "ax[0,1].set_title('Euclidean reverse (ambient)')\n",
    "\n",
    "# Riemannian reverse\n",
    "traj_riem_xy = theta_to_xy(traj_riem.reshape(-1)).reshape(traj_riem.shape[0], traj_riem.shape[1], 2)\n",
    "ax[0,2].scatter(x_riem[:,0], x_riem[:,1], s=4, alpha=0.25, color='tab:green')\n",
    "for k in range(traj_riem_xy.shape[1]):\n",
    "    ax[0,2].plot(traj_riem_xy[:,k,0], traj_riem_xy[:,k,1], color='black', lw=0.8, alpha=0.45)\n",
    "ax[0,2].set_title('Riemannian reverse on S^1')\n",
    "\n",
