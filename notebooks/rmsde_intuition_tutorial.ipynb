   "source": [
    "## 3) Side-by-side minimal example A: Euclidean VP-SDE on a 2D Gaussian mixture\n",
    "\n",
    "This mirrors your LDM-style Euclidean diffusion assumptions, but we use an analytic score (no neural training) so we can isolate SDE mechanics.\n",
    "\n",
    "If $p_0(x)=\\sum_k\\pi_k\\mathcal N(\\mu_k,\\Sigma_k)$ and VP noising is\n",
    "$$x_t=\\alpha(t)x_0+\\sigma(t)\\epsilon,$$\n",
    "then\n",
    "$$p_t(x)=\\sum_k\\pi_k\\mathcal N(\\alpha(t)\\mu_k,\\alpha(t)^2\\Sigma_k+\\sigma(t)^2I).$$\n",
    "So $\\nabla_x\\log p_t(x)$ is analytic as a posterior-weighted Gaussian score sum."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1500x420 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# ---------- Euclidean GMM setup ----------\n",
    "means = np.array([[-2.0, 0.0], [2.0, 0.0], [0.0, -2.0], [0.0, 2.0]])\n",
    "K = len(means)\n",
    "weights = np.ones(K) / K\n",
    "cov_base = 0.08 * np.eye(2)\n",
    "covs = np.repeat(cov_base[None, :, :], K, axis=0)\n",
    "\n",
    "def sample_gmm(n):\n",
    "    c = np.random.choice(K, size=n, p=weights)\n",
    "    z = np.random.randn(n, 2)\n",
    "    L = np.linalg.cholesky(cov_base)\n",
    "    return means[c] + z @ L.T\n",
    "\n",
    "def gmm_score_vp(x, t):\n",
    "    # q_t component params\n",
    "    a = alpha_t(t)\n",
    "    ab = alpha_bar(t)\n",
    "    s2 = sigma_t(t) ** 2\n",
    "\n",
    "    m_t = a * means                                  # (K,2)\n",
    "    C_t = ab * covs + s2 * np.eye(2)[None, :, :]     # (K,2,2)\n",
    "    C_inv = np.linalg.inv(C_t)                        # (K,2,2)\n",
    "    log_det = np.log(np.linalg.det(C_t))              # (K,)\n",
    "\n",
    "    # log component densities\n",
    "    # diff: (N,K,2)\n",
    "    diff = x[:, None, :] - m_t[None, :, :]\n",
    "    maha = np.einsum('nki,kij,nkj->nk', diff, C_inv, diff)\n",
    "    log_comp = np.log(weights)[None, :] - 0.5 * (2 * np.log(2*np.pi) + log_det[None, :] + maha)\n",
    "\n",
    "    # posterior responsibilities\n",
    "    mx = np.max(log_comp, axis=1, keepdims=True)\n",
    "    resp = np.exp(log_comp - mx)\n",
    "    resp = resp / np.sum(resp, axis=1, keepdims=True)\n",
    "\n",
    "    # score for each component: -C^{-1}(x-m)\n",
    "    comp_score = -np.einsum('kij,nkj->nki', C_inv, diff)  # (N,K,2)\n",
    "    score = np.einsum('nk,nki->ni', resp, comp_score)\n",
    "    return score\n",
    "\n",
    "def reverse_vp_sampler(score_fn, n_samples=3000, n_steps=400, t_eps=1e-3):\n",
    "    x = np.random.randn(n_samples, 2)  # prior approx at t=1\n",
    "    ts = np.linspace(1.0, t_eps, n_steps)\n",
    "    traj_idx = np.random.choice(n_samples, size=24, replace=False)\n",
    "    traj = [x[traj_idx].copy()]\n",
    "\n",
    "    for i in range(n_steps - 1):\n",
    "        t = ts[i]\n",
    "        dt = ts[i] - ts[i+1]  # positive\n",
    "        b = beta_t(t)\n",
    "        s = score_fn(x, t)\n",
    "\n",
    "        # reverse SDE with VP forward drift f=-0.5*beta*x\n",
    "        drift = 0.5 * b * x + b * s\n",
    "        x = x + drift * dt + np.sqrt(b * dt) * np.random.randn(*x.shape)\n",
    "\n",
    "        if i % 12 == 0:\n",
    "            traj.append(x[traj_idx].copy())\n",
    "\n",
    "    return x, np.array(traj)\n",
    "\n",
    "# Forward and reverse demo\n",
    "x0 = sample_gmm(4000)\n",
    "tT = 1.0\n",
    "xT = alpha_t(tT) * x0 + sigma_t(tT) * np.random.randn(*x0.shape)\n",
    "x_rec, traj = reverse_vp_sampler(gmm_score_vp, n_samples=4000, n_steps=350)\n",
    "\n",
    "fig, ax = plt.subplots(1, 3, figsize=(15, 4.2))\n",
    "ax[0].scatter(x0[:,0], x0[:,1], s=4, alpha=0.25)\n",
    "ax[0].set_title('Target data $p_0$ (2D GMM)')\n",
    "ax[1].scatter(xT[:,0], xT[:,1], s=4, alpha=0.25, color='tab:orange')\n",
    "ax[1].set_title('Forward noised $q_{t=1}$ (near Gaussian)')\n",
    "ax[2].scatter(x_rec[:,0], x_rec[:,1], s=4, alpha=0.25, color='tab:green')\n",
    "for k in range(traj.shape[1]):\n",
    "    ax[2].plot(traj[:,k,0], traj[:,k,1], lw=1.0, alpha=0.6, color='black')\n",
    "ax[2].set_title('Reverse samples (oracle score)')\n",
    "for a in ax:\n",
    "    a.set_aspect('equal')\n",
    "    a.set_xlim(-4, 4)\n",
    "    a.set_ylim(-4, 4)\n",
    "    a.grid(alpha=0.25)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
